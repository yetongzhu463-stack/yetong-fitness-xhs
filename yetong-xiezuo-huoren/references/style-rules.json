  "patterns": [
    {
      "id": "W201",
      "label": "疑似翻案",
      "severity": "review",
      "genres": [
        "social",
        "spoken",
        "prose",
        "fiction"
      ],
      "patterns": [
        "(?:并)?不是[^。！？\\n]{0,90}而是",
        "不(?:仅仅|仅|只|单)是[^。！？\\n]{0,90}而是",
        "并非[^。！？\\n]{0,90}而是",
        "不在于[^。！？\\n]{0,90}而在于",
        "与其说[^。！？\\n]{0,90}(?:不如|毋宁|倒不如)",
        "[。！？!?]\\s*而是",
        "表面(?:上)?[^。！？\\n]{0,90}(?:其实|实际|实则)",
        "看似[^。！？\\n]{0,90}(?:其实|实际|实则)"
      ],
      "message": "检查是否虚构误解再推翻；正常事实纠正或有材料的认识变化可以保留。"
    },
    {
      "id": "W202",
      "label": "疑似翻案变形",
      "severity": "review",
      "genres": [
        "social",
        "spoken",
        "prose",
        "fiction"
      ],
      "patterns": [
        "(?:总|一直|曾|都)?以为[^！？\\n]{2,60}?(?:其实|才发现|才明白|才知道|后来才)",
        "(?:总|都|一直)以为[^！？\\n]{2,60}?[。，](?:可|但|其实)",
        "回头(?:看|一看)?才(?:发现|明白|知道)",
        "(?:并)?不是[^。！？\\n]{1,40}，(?:更|才)?是[^，。！？\\n]",
        "从来(?:都)?(?:不是|与[^。！？，\\n]{1,12}无关)",
        "答案(?:是否定的|恰恰相反)|恰恰相反",
        "[^，。！？\\n]{1,12}不重要，(?:重要|要紧)的是",
        "真正[^，。！？\\n]{0,16}的(?:，)?是",
        "不只(?:是)?[^。！？\\n]{0,90}(?:还|也)"
      ],
      "message": "仅作语境复核线索，正常递进和自我修正不自动删除。"
    },
    {
      "id": "W203",
      "label": "名词化",
      "severity": "review",
      "genres": [
        "social",
        "spoken",
        "prose",
        "fiction"
      ],
      "patterns": [
        "进行(?:了|一次|一场|着)?[^。，！？\\n]{0,10}(?:调整|优化|升级|分析|讨论|沟通|梳理|复盘|迭代|探索|尝试|思考|规划|布局)",
        "实现了?[^。，！？\\n]{0,14}的?[^。，！？\\n]{0,6}(?:提升|增长|突破|转变|跃升|落地)",
        "完成了?对[^。，！？\\n]{0,16}的",
        "起到了?[^。，！？\\n]{0,12}的?作用",
        "具有[^。，！？\\n]{0,10}(?:意义|价值)"
      ],
      "message": "试着直接写动作；名词本身是对象时可以保留。"
    },
    {
      "id": "W204",
      "label": "模型路标",
      "severity": "review",
      "genres": [
        "social",
        "spoken",
        "prose",
        "fiction"
      ],
      "patterns": [
        "(?:^|[。！？!?，,；;]\\s*)(?:更微妙的是|只说对了一半|值得注意的是|需要指出的是|从某种意义上说|总而言之|综上所述)[^。！？!?\\n]{0,24}",
        "(?:^|[。！？!?，,；;]\\s*)还有一层(?=(?:更|原因|问题|意思|考虑|变化|逻辑|价值|作用|风险|影响|值得|很少|不容易|常被|往往))[^。！？!?\\n]{0,24}"
      ],
      "message": "核对是否只是给段落排队或抬价，准确本义不必改。"
    },
    {
      "id": "W205",
      "label": "时代开篇",
      "severity": "review",
      "genres": [
        "social",
        "spoken",
        "prose"
      ],
      "location": "opening",
      "patterns": [
        "(?:^|(?<=[。！？!?]))[ \\t]*在当今[^，。！？\\n]{0,16}(?:时代|社会|世界)",
        "(?:^|(?<=[。！？!?]))[ \\t]*在这个[^，。！？\\n]{0,16}的(?:时代|年代)"
      ],
      "message": "若只是铺垫，可从具体事情起笔；确实讨论该尺度时判断是否必要。"
    },
    {
      "id": "W206",
      "label": "号召结尾",
      "severity": "review",
      "genres": [
        "social",
        "spoken",
        "prose"
      ],
      "location": "closing",
      "exclude_quotes": true,
      "patterns": [
        "(?:^|(?<=[。！？!?]))[ \\t]*(?:[^，。！？\\n]{1,6}，)?让我们[^。！？\\n]{0,30}吧"
      ],
      "message": "用户没有要求号召时检查是否多加了一句。"
    },
    {
      "id": "W207",
      "label": "众所周知",
      "severity": "review",
      "genres": [
        "social",
        "spoken",
        "prose",
        "fiction"
      ],
      "patterns": [
        "(?:^|(?<=[。！？!?]))[ \\t]*众所周知"
      ],
      "message": "检查是否用共识口气代替材料。"
    }
  ],
